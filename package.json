{
  "name": "coding-agent-adapters",
  "version": "0.17.0",
  "description": "CLI adapters for AI coding agents - Claude Code, Gemini CLI, OpenAI Codex, Aider, OpenCode, and Hermes Agent",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HaruHunab1320/coding-agent-adapters.git"
  },
  "homepage": "https://github.com/HaruHunab1320/coding-agent-adapters#readme",
  "bugs": {
    "url": "https://github.com/HaruHunab1320/coding-agent-adapters/issues"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "cli",
    "adapters",
    "claude",
    "gemini",
    "codex",
    "aider",
    "hermes",
    "ai-agents",
    "coding-agents",
    "pty-manager"
  ],
  "author": "Parallax",
  "license": "MIT",
  "dependencies": {
    "adapter-types": "^0.2.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@pinojs/redact": "^0.4.0",
    "@types/node": "^20.0.0",
    "pty-manager": "^1.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
